{
  "name": "luma",
  "version": "0.1.0",
  "private": true,
  "description": "Luma — Your AI on Windows. An open-source Windows AI Agent that understands your goals and operates your computer.",
  "author": "SYSTEM-Intel-MIC",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SYSTEM-Intel-MIC/Luma.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @luma/desktop dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter '!@luma/desktop' build",
    "build:desktop": "pnpm --filter @luma/desktop build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "pnpm -r clean",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "@vitest/coverage-v8": "^3.1.3",
    "zod": "^3.24.4"
  }
}