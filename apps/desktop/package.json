{
  "name": "@luma/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Luma desktop application — an open-source AI agent for Windows.",
  "author": "SYSTEM-Intel-MIC",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && pnpm run build:vite && pnpm run build:electron",
    "build:vite": "vite build",
    "build:electron": "electron-builder --win --x64 --config electron-builder.yml",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "clean": "rm -rf dist dist-electron release"
  },
  "dependencies": {
    "@luma/shared": "workspace:*",
    "@luma/agent": "workspace:*",
    "@luma/models": "workspace:*",
    "@luma/tools": "workspace:*",
    "@luma/permissions": "workspace:*",
    "@luma/memory": "workspace:*",
    "@luma/storage": "workspace:*",
    "better-sqlite3": "^11.9.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
